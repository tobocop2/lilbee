# Pinned sources for the bundled engine, shared by the wheel build
# (tools/wheel-build/build_llama_server.sh) and CI's engine-helper install.
# Bump deliberately; a change here invalidates the cached engine binaries.
#
# ENGINE_LLAMA_CPP_REPO / ENGINE_LLAMA_CPP_REF: the llama.cpp source
# llama-server is built from, cloned directly at that ref. The ref is an
# immutable memory-YYYYMMDD-HHMMSS tag on the fork's master: the latest upstream
# llama.cpp with the GET /memory work (upstream PR 26130, the readback
# source) merged in. The fork's weekly sync-upstream workflow produces the
# tags; the engine-pin-sync workflow here proposes bumps as a rolling PR.
# Point back at ggml-org/llama.cpp when PR 26130 merges upstream.
#
# A cell can override both via LLAMA_CPP_REPO / LLAMA_CPP_REF. cu121 pins
# upstream b9665 (CUDA 12.1's nvcc cannot compile the newer CUDA kernels);
# engines built from refs predating PR 26130 lack GET /memory and use the
# log-parse readback.
#
# Do not move this pin to memory-20260921-150014. That tag carries upstream
# llama.cpp 1884824f, which gives the five argument load_ldmatrix only a
# tile<16,8> overload while the sm_70 tile is tile<8,4>, so every CUDA cell
# fails to compile fattn.cu. Upstream b1c2863e fixes it; the next fork sync tag
# past that commit is safe.
ENGINE_LLAMA_CPP_REPO=https://github.com/tobocop2/llama.cpp
ENGINE_LLAMA_CPP_REF=memory-20261017-193536

# The two Go engine helpers bundled alongside llama-server, built from source
# (deterministic, no release-asset-name guessing).
ENGINE_LLAMA_SWAP_VERSION=v265
# Pinned to a tag so the pin string names the build: the engine cache keys on
# this file, so a branch ref would let upstream pushes change the binaries
# without a rebuild. v0.26.4 is the first tag with the compute buffer sizing
# (gpustack/gguf-parser-go#58) and the projector key type check (#59).
ENGINE_GGUF_PARSER_REPO=https://github.com/gpustack/gguf-parser-go.git
ENGINE_GGUF_PARSER_REF=v0.26.4

# ENGINE_GO_VERSION: the Go toolchain that builds those helpers, consumed by
# ci.yml, build-multigpu.yml, the bundle-llama-server action and the QA pod
# scripts. llama-swap's go.mod sets the floor (v265 wants >= 1.27.1); the builds
# run with GOTOOLCHAIN=local so a go.mod bump past this pin fails loudly instead
# of silently downloading one.
ENGINE_GO_VERSION=1.27.2

# ENGINE_VULKAN_SDK_VERSION: the LunarG SDK the Linux vulkan cells build against.
# It carries glslc and the SPIR-V headers, neither of which apt provides on the
# jammy runner. Shared by install_gpu_toolkit.sh, release.yml and
# flatpak-validate.yml so the three cannot drift.
ENGINE_VULKAN_SDK_VERSION=1.3.296.0

# ENGINE_ROCM_VERSION: installed, compiled against, and bundled by the rocm cell.
# Below 6.1 llama.cpp refuses to build and 6.1 fails on ggml-cuda/mma.cuh. A bump
# can drop GPU targets; cmake_args.sh filters those against the toolchain.
ENGINE_ROCM_VERSION=7.2.0

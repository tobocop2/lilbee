#!/usr/bin/env bash
# Stand-in for docker when pack_ik.sh builds a cell. The build call writes what ik_llama_manylinux.sh leaves in the
# mounted checkout. The other call writes the driver stub into the folder mounted at /stub.
#
# Reads:
#   DOCKER_LOG   a file that receives "== call" and the arguments, one per line, per call (required)
#   DOCKER_FAIL  build or stub: the call that fails
#   SOURCE_WITHOUT  a file of the source tree to leave out
#   EMPTY_LICENSE   when set, the LICENSE file of the source is empty
#   CHANGED_LIB     when set, libcublas.so.12 differs from the file that cuda-libs.sha256 lists
# and BACKEND, as the container does.

set -euo pipefail

{ echo "== call"; printf '%s\n' "$@"; } >> "${DOCKER_LOG:?}"
mount=""
build=0
for arg in "$@"; do
  case "${arg}" in
    *:/work) mount="${arg%:/work}" ;;
    *:/stub) stub="${arg%:/stub}" ;;
    BIN_DIR=/work/* | SRC_DIR=/work/* | SHA_FILE=/work/* | NOTICE_FILE=/work/*) declare "${arg%%=*}=${mount}/${arg#*=/work/}" ;;
    */ik_llama_manylinux.sh) build=1 ;;
  esac
done
if [ "${build}" -eq 0 ]; then
  [ "${DOCKER_FAIL-}" != stub ] || { echo "stub docker: failed" >&2; exit 1; }
  : > "${stub:?}/libcuda.so.1"
  exit 0
fi
[ -d "${BIN_DIR:?}" ] || { echo "stub docker: no folder ${BIN_DIR}" >&2; exit 1; }

# The server writes its arguments and its library path.
cat > "${BIN_DIR}/llama-server" <<'SH'
#!/bin/sh
echo "server $* | libraries=${LD_LIBRARY_PATH-unset} cwd=${PWD}" >> "${SERVER_LOG}"
exit "${SERVER_FAIL:-0}"
SH
chmod 755 "${BIN_DIR}/llama-server"

grant='Permission is hereby granted, free of charge, to any person obtaining a copy'
source_file() {  # path line...
  local path="${SRC_DIR:?}/$1"
  shift
  mkdir -p "$(dirname "${path}")"
  printf '%s\n' "$@" > "${path}"
}
source_file LICENSE "MIT License" "" "Copyright (c) 2023 The ggml authors" "" "${grant}"
source_file vendor/nlohmann/json.hpp "// Niels Lohmann" "// ${grant}" "int json;"
source_file vendor/cpp-httplib/httplib.h "// Yuji Hirose" "// ${grant}" "int http;"
source_file vendor/stb/stb_image.h "int image;" "This software is available under 2 licenses" "ALTERNATIVE A - MIT License" "${grant}"
source_file vendor/stb/stb_image_resize2.h "int resize;" "This software is available under 2 licenses" "ALTERNATIVE A - MIT License" "Copyright (c) 2017 Sean Barrett" "${grant}"
source_file vendor/miniaudio/miniaudio.h "int audio;" "ALTERNATIVE 1 - Public Domain" "This is free and unencumbered software released into the public domain" "ALTERNATIVE 2 - MIT No Attribution" "MIT No Attribution"
source_file tools/ui/LICENSE "${grant}"
source_file examples/other/LICENSE "${grant}"
source_file examples/server/sqlite_modern_cpp/License.txt "${grant}"
source_file examples/server/public/index.html "/** @license React" " * MIT license */"
source_file examples/server/public_llamacpp/index_llamacpp.html "/** Copyright 2024 Mozilla Foundation" " * Licensed under the Apache License, Version 2.0 */"
gzip "${SRC_DIR}/examples/server/public/index.html" "${SRC_DIR}/examples/server/public_llamacpp/index_llamacpp.html"
[ -z "${EMPTY_LICENSE-}" ] || : > "${SRC_DIR}/LICENSE"
git -C "${SRC_DIR}" init -q -b main
git -C "${SRC_DIR}" add .
GIT_COMMITTER_DATE='1700000000 +0000' git -C "${SRC_DIR}" -c user.name=t -c user.email=t@example.test -c commit.gpgsign=false commit -q -m source
[ -z "${SOURCE_WITHOUT-}" ] || mv "${SRC_DIR}/${SOURCE_WITHOUT}" "${SRC_DIR}/.git/"

if [ "${BACKEND:?}" = cuda ]; then
  for lib in libcudart.so.12 libcublas.so.12 libcublasLt.so.12; do echo "${lib}" > "${BIN_DIR}/${lib}"; done
  (cd "${BIN_DIR}" && sha256sum -b libcudart.so.12 libcublas.so.12 libcublasLt.so.12) > "${SHA_FILE:?}"
  [ -z "${CHANGED_LIB-}" ] || echo changed >> "${BIN_DIR}/libcublas.so.12"
  { echo "Attachment A: libcudart libcublas libcublasLt"; printf 'EULA text %s.\n' {1..2000}; } > "${NOTICE_FILE:?}"
fi
# A check at the end of the build fails when every file is in place.
[ "${DOCKER_FAIL-}" != build ] || { echo "stub docker: failed" >&2; exit 1; }

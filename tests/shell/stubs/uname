#!/usr/bin/env bash
# Stand-in for uname: answers from UNAME_S and UNAME_M.
case "$1" in
  -s) echo "${UNAME_S:-Linux}" ;;
  -m) echo "${UNAME_M:-x86_64}" ;;
  # pip reads the release for its user agent.
  -rs) echo "${UNAME_S:-Linux} 1.0" ;;
  *) echo "stub uname: unsupported flag $1" >&2; exit 1 ;;
esac

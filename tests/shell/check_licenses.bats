#!/usr/bin/env bats
# tools/ci/check_licenses.sh feeds the marker-free lock export to the licence checker and fails when it fails.

setup() {
  REPO_ROOT="$(cd "${BATS_TEST_DIRNAME}/../.." && pwd)"
  SCRIPT="${REPO_ROOT}/tools/ci/check_licenses.sh"
  STUBS="${BATS_TEST_TMPDIR}/bin"
  mkdir -p "${STUBS}"
  cat > "${STUBS}/uv" <<'STUB'
#!/usr/bin/env bash
# Stand-in for uv: `export` prints a lock export, `run` echoes the list it was given
# and records each command line. A licensecheck call without --zero exits 9.
echo "$*" >> "${BATS_TEST_TMPDIR}/calls"
case "$1" in
  export)
    if [[ "$*" == *"--only-group"* ]]; then
      echo "licensecheck==1.0 ; python_full_version >= '3.12'"
    else
      printf '# autogenerated\nwinonly==1.0 ; sys_platform == '"'"'win32'"'"'\nplain==2.0\n'
    fi ;;
  run)
    if [[ "$*" == *" licensecheck "* && "$*" != *" --zero"* ]]; then exit 9; fi
    if [[ "$*" == *" python "* && -n "${STUB_PY_RC:-}" ]]; then exit "${STUB_PY_RC}"; fi
    while [ "$#" -gt 0 ]; do
      if [ "$1" = "--requirements-paths" ]; then cat "$2"; break; fi
      shift
    done
    exit "${STUB_RC:-0}" ;;
esac
STUB
  chmod +x "${STUBS}/uv"
  PATH="${STUBS}:${PATH}"
}

@test "the lock export reaches the checker without markers or comments" {
  run bash "${SCRIPT}"
  [ "$status" -eq 0 ]
  [[ "$output" == *"winonly==1.0"* ]]
  [[ "$output" != *"win32"* ]]
  [[ "$output" != *"autogenerated"* ]]
}

@test "a failing checker fails the script" {
  STUB_RC=1 run bash "${SCRIPT}"
  [ "$status" -eq 1 ]
}

@test "a requirements file argument replaces the lock export" {
  printf 'custom==9.9\n' > "${BATS_TEST_TMPDIR}/reqs.txt"
  run bash "${SCRIPT}" "${BATS_TEST_TMPDIR}/reqs.txt"
  [ "$status" -eq 0 ]
  [[ "$output" == *"custom==9.9"* ]]
  [[ "$output" != *"plain==2.0"* ]]
}

@test "licensecheck runs with --zero so an incompatible package fails the run" {
  run bash "${SCRIPT}"
  [ "$status" -eq 0 ]
  grep -q -- " licensecheck .* --zero" "${BATS_TEST_TMPDIR}/calls"
}

@test "the copyleft step reads the licensecheck report and the pyproject allow list" {
  run bash "${SCRIPT}"
  [ "$status" -eq 0 ]
  grep -q -- " python -I tools/ci/check_copyleft.py .*/report.json pyproject.toml" "${BATS_TEST_TMPDIR}/calls"
}

@test "make check runs the licence check and make lint does not" {
  run make -C "${REPO_ROOT}" -n check
  [[ "$output" == *"tools/ci/check_licenses.sh"* ]]
  run make -C "${REPO_ROOT}" -n lint
  [[ "$output" != *"tools/ci/check_licenses.sh"* ]]
}

@test "a failing copyleft step fails the script when licensecheck passes" {
  STUB_PY_RC=1 run bash "${SCRIPT}"
  [ "$status" -eq 1 ]
}

# Pin of the OpenVINO runtime that the llama.cpp OpenVINO pack builds against and ships.
# The llama.cpp source is not pinned here: the pack is one cell of the llama.cpp pack build and
# builds the same llama.cpp tag as the CPU, Vulkan, CUDA and ROCm cells. Both llama.cpp engine cache
# keys hash this file, so a runtime bump rebuilds every llama.cpp engine and renames its mirror asset.
#
# Upstream llama.cpp builds its OpenVINO release with OpenVINO 2026.4.1 (docs/backend/OPENVINO.md).
# This pin takes the PyPI `openvino` wheel of that version, which is Apache-2.0 (License-Expression
# in its METADATA). The wheel holds the same CPU, GPU and NPU plugins, the headers and the cmake
# configs of OpenVINO and oneTBB. Its libraries need glibc 2.27 and GLIBCXX_3.4.22, under the
# manylinux_2_34 floor of the pack.
# OPENVINO_WHEEL_SHA256 is the digest that pypi.org/pypi/openvino/2026.4.1/json publishes for the file.
OPENVINO_VERSION=2026.4.1
OPENVINO_WHEEL_URL=https://files.pythonhosted.org/packages/ec/3a/2a173ac1ad749ff0b041788eefc1ade0d410231fedfc43f77474f3b806cc/openvino-2026.4.1-22982-cp312-cp312-manylinux_2_28_x86_64.whl
OPENVINO_WHEEL_SHA256=6b4375c17ddcac83a5180349e2e2bb811185c261066e2a920659892d58ef0e3b
# The wheel ships libtbb of oneTBB 2021.13.1 and the third-party notice of OpenVINO, whose copy
# turns the public-domain item 4 (a libstdc++ workaround that libtbb does not hold) into a
# GPL-3.0 text. The pack ships the notice and the licence of the oneTBB tag of that version instead.
ONETBB_VERSION=2021.13.1
ONETBB_NOTICE_URL=https://raw.githubusercontent.com/uxlfoundation/oneTBB/v2021.13.1/third-party-programs.txt
ONETBB_NOTICE_SHA256=1634857eb058dce5278c57a832b8974190785145f4be9acdbdb511f3a0c4091c
ONETBB_LICENSE_URL=https://raw.githubusercontent.com/uxlfoundation/oneTBB/v2021.13.1/LICENSE.txt
ONETBB_LICENSE_SHA256=c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4
# The release cell of the pack: the llama.cpp pack build runs this script for this cell.
OPENVINO_CELL=linux-x86_64-openvino
OPENVINO_BACKEND=openvino
OPENVINO_PLATFORM=manylinux_2_34_x86_64
OPENVINO_BUILD_SCRIPT=tools/wheel-build/llama_gpu_manylinux.sh

# Pin of the mlx engine pack. The engine build workflow reads this file, runs the build script
# named below on the macOS cell named below, and keys its cache on this file.
#
# The pack is a relocatable CPython (python-build-standalone, installed by uv) with mlx-lm and its
# packages from packaging/engine-mlx/requirements.txt, frozen into one wheel. mlx and mlx-metal are
# the macosx_14_0 files, so the wheel tag, the metallib and the macOS floor agree. A bump of
# MLX_LM_VERSION needs a new requirements file and a new MLX_VERSION; the build script stops until
# the three agree. MLX_LM_VERSION is also the version of the mlx adapter.
MLX_LM_VERSION=0.32.2
MLX_VERSION=0.32.4
MLX_PYTHON=3.12
MLX_UV_VERSION=0.13.7
MLX_DELOCATE_VERSION=0.13.0
MLX_FLOOR=14.0
MLX_PLATFORM=macosx_14_0_arm64
MLX_BACKEND=metal
MLX_CELL=macos-arm64-metal
MLX_REQUIREMENTS=packaging/engine-mlx/requirements.txt
MLX_BUILD_SCRIPT=tools/wheel-build/mlx_wheel.sh

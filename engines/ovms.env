# Pin of the OpenVINO Model Server pack. The engine build workflow reads this file, runs the
# repackage script named below and keys its cache on this file.
#
# The archive is the upstream release asset, repackaged as it is: the Red Hat build links against
# glibc 2.34, the floor of the manylinux_2_34 wheels, and the Python-off build needs no Python at
# run time. Per the OpenVINO Model Server docs, a Python-off build has no tool calling in chat.
# OVMS_ARCHIVE_SHA256 is the digest that the release publishes in the .sha256 asset of the archive.
OVMS_VERSION=2026.4.1
OVMS_ARCHIVE_URL=https://github.com/openvinotoolkit/model_server/releases/download/v2026.4.1/ovms_redhat_2026.4.1_python_off.tar.gz
OVMS_ARCHIVE_SHA256=92209b34c5e7ecc0cde06d4835688f4aa321a194207edab81fc0e84009ab1f5d
OVMS_PLATFORM=manylinux_2_34_x86_64
OVMS_BACKEND=openvino
OVMS_REPACKAGE_SCRIPT=tools/wheel-build/ovms_wheel.sh

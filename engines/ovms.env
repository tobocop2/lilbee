# Pin of the OpenVINO Model Server pack. The engine build workflow reads this file, runs the
# repackage script named below and keys its cache on this file.
#
# The archive is the upstream Ubuntu 24 release asset, with no Python at run time. Per the
# OpenVINO Model Server docs, a Python-off build has no tool calling in chat. The archive does not
# ship libtbb.so.12, so the repackage script adds it from the PyPI tbb wheel. The binary needs
# glibc 2.38, so the wheel platform is manylinux_2_38. The Red Hat archive is not used: it needs
# OpenSSL 3.4 and also lacks libtbb.
# OVMS_ARCHIVE_SHA256 is the digest that the release publishes in the .sha256 asset of the archive.
OVMS_VERSION=2026.4.1
OVMS_ARCHIVE_URL=https://github.com/openvinotoolkit/model_server/releases/download/v2026.4.1/ovms_ubuntu24_2026.4.1_python_off.tar.gz
OVMS_ARCHIVE_SHA256=2b7198671a9e99e030b408601733fbd61798d8a741337c867b96eb41c295b3f8
OVMS_TBB_VERSION=2023.2.0
OVMS_PLATFORM=manylinux_2_38_x86_64
OVMS_BACKEND=openvino
OVMS_REPACKAGE_SCRIPT=tools/wheel-build/ovms_wheel.sh

{
  "name": "lilbee",
  "version": "0.6.90-beta.691",
  "description": "The whole local AI stack in one executable: run and manage local models across every GPU you have, and search your files, notes, code, and crawled sites with answers that cite the source. Terminal app, CLI, MCP server, and REST API. Auto-detects your hardware (CUDA, ROCm, Metal) and fetches the matching standalone binary on first use.",
  "license": "MIT",
  "homepage": "https://lilbee.sh",
  "bugs": "https://github.com/tobocop2/lilbee/issues",
  "type": "module",
  "main": "./lib/api.mjs",
  "types": "./lib/api.d.ts",
  "exports": {
    ".": {
      "types": "./lib/api.d.ts",
      "default": "./lib/api.mjs"
    },
    "./server": "./plugin/server.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "lilbee": "bin/lilbee.mjs",
    "lilbee-mcp": "bin/lilbee-mcp.mjs"
  },
  "files": [
    "bin",
    "lib",
    "plugin",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "node scripts/copy-skills.mjs",
    "pretest": "node scripts/copy-skills.mjs",
    "test": "node --test"
  },
  "lilbee": {
    "repo": "tobocop2/lilbee",
    "release": "v0.6.90b691",
    "glibcFloor": "2.34"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobocop2/lilbee.git",
    "directory": "packages/lilbee"
  },
  "keywords": [
    "lilbee",
    "mcp",
    "mcp-server",
    "local-ai",
    "local-llm",
    "rag",
    "llama.cpp",
    "semantic-search",
    "embeddings",
    "ai-search",
    "privacy",
    "pi-package",
    "opencode-plugin"
  ],
  "optionalDependencies": {
    "undici": "^6.29.1"
  },
  "pi": {
    "extensions": [
      "./plugin/extensions"
    ],
    "skills": [
      "./skills"
    ]
  }
}

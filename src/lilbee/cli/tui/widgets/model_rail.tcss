ModelRail {
    width: 26;
    height: 1fr;
    padding: 1 1;
    background: $surface;
    border-right: tall $panel-darken-2;
}

ModelRail .rail-heading {
    color: $text-muted;
    text-style: bold;
    padding: 0 1;
}

RoleRow {
    layout: horizontal;
    height: 1;
    padding: 0 1;
}

RoleRow .role-dot {
    width: 2;
    color: $text-muted;
}

RoleRow.-active .role-dot {
    color: $success;
}

RoleRow.-active.-vision .role-dot {
    color: #bc8cff;
}

RoleRow.-active.-rerank .role-dot {
    color: #f0883e;
}

RoleRow .role-label {
    width: 7;
    color: $text;
    text-style: bold;
}

RoleRow.-off .role-label {
    color: $text-muted;
    text-style: none;
}

RoleRow ModelPickerButton {
    width: 1fr;
    color: $text;
    background: transparent;
    padding: 0;
}

RoleRow.-off ModelPickerButton {
    color: $text-muted;
}

RoleRow ModelPickerButton:focus {
    background: $boost;
    text-style: bold;
}

ModelRail ChatModeToggle {
    padding: 1 1 0 1;
    height: auto;
}

ModelRail #chat-mode-toggle {
    width: auto;
    height: 1;
    margin: 0 1 0 0;
    padding: 0;
    background: transparent;
}

ModelRail #chat-mode-toggle Horizontal {
    height: 1;
    width: auto;
}

ModelRail .chat-mode-pill {
    width: auto;
    height: 1;
    padding: 0 1;
    margin: 0 1 0 0;
    background: $boost;
    color: $text-muted;
}

ModelRail .chat-mode-pill.-active {
    background: $success;
    color: $text;
}

ModelRail .chat-mode-pill.-disabled {
    color: $text 40%;
    text-style: dim;
}

ModelRail .chat-mode-pill:focus {
    text-style: bold;
    background: $accent;
    color: $text;
}

ModelRail .cloud-warning {
    color: $warning;
    padding: 1 1 0 1;
    height: auto;
}

ModelRail .cloud-warning.-visible {
    display: block;
}

ModelRail .cloud-warning {
    display: none;
}

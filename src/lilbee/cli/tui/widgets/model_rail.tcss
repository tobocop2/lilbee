ModelRail {
    width: 26;
    height: 1fr;
    padding: 1 1;
    background: $surface;
    border-right: tall $panel-darken-2;
}

ModelRail .rail-heading {
    color: $text-muted;
    text-style: bold;
    padding: 0 1;
}

ModelRail .rail-divider {
    color: $panel-darken-2;
    padding: 0 1;
}

RoleRow {
    layout: horizontal;
    height: 1;
    padding: 0 1;
}

RoleRow .role-dot {
    width: 2;
    color: $text-muted;
}

RoleRow.-active .role-dot {
    color: $success;
}

RoleRow.-active.-vision .role-dot {
    color: #bc8cff;
}

RoleRow.-active.-rerank .role-dot {
    color: #f0883e;
}

RoleRow .role-label {
    width: 7;
    color: $text;
    text-style: bold;
}

RoleRow.-off .role-label {
    color: $text-muted;
    text-style: none;
}

RoleRow ModelPickerButton {
    width: 1fr;
    color: $text;
    background: transparent;
    padding: 0;
}

RoleRow.-off ModelPickerButton {
    color: $text-muted;
}

RoleRow ModelPickerButton:focus {
    background: $boost;
    text-style: bold;
}

ModelRail ChatModeToggle {
    padding: 1 1 0 1;
    height: auto;
}

ModelRail .cloud-warning {
    color: $warning;
    padding: 1 1 0 1;
    height: auto;
}

ModelRail .cloud-warning.-visible {
    display: block;
}

ModelRail .cloud-warning {
    display: none;
}

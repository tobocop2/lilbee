ViewTabs {
    height: 1;
    width: 100%;
    /* No strip background: inherit the screen's $background so the
     * active tab's $surface pill pops against it the same way Settings
     * sub-tabs do. With background: $surface here the active pill would
     * be invisible against the strip. */
    background: transparent;
}

ViewTabs > Horizontal {
    height: 1;
    width: 100%;
}

ViewTabs Static {
    width: auto;
}

.view-tab {
    width: auto;
    padding: 0;
}

.view-tab:hover {
    text-style: bold;
}

/* Active tab gets the same highlighted pill as Settings sub-tabs
 * (#settings-tabs Tab.-active in screens/settings.tcss). Only the active
 * tab is highlighted; tab-cycling keyboard focus does NOT add a competing
 * underline on a non-active tab. The active tab is the single source of
 * "where am I" truth. */
.view-tab.-active {
    background: $surface;
}

/* When focus lands on the already-active tab, mirror Settings sub-tab's
 * focused-active state: $accent + bold underline. Focus on a non-active
 * tab is intentionally invisible -- the active tab stays the only
 * highlighted one. */
.view-tab.-active:focus {
    color: $accent;
    text-style: bold underline;
}

.view-tab-sep {
    width: auto;
    color: $text-muted;
}

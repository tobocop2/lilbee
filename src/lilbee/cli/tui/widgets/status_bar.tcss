ViewTabs {
    height: 1;
    width: 100%;
    /* No strip background: inherit the screen's $background so the
     * active tab's $surface pill pops against it the same way Settings
     * sub-tabs do. With background: $surface here the active pill would
     * be invisible against the strip. */
    background: transparent;
}

ViewTabs > Horizontal {
    height: 1;
    width: 100%;
}

ViewTabs Static {
    width: auto;
}

/* The trailing pills take the width the tabs leave, and a long project path ends in an ellipsis. */
ViewTabs #view-tabs-trailing {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.view-tab {
    width: auto;
    padding: 0;
}

.view-tab:hover {
    text-style: bold;
}

/* Active tab gets the same highlighted pill as Settings sub-tabs
 * (#settings-tabs Tab.-active in screens/settings.tcss). The pill is the
 * SOLE indicator of which tab is current. No :focus override layered on
 * top: a mouse click and a keyboard > / < cycle produce the exact same
 * visual, no second highlight when the tab also has keyboard focus. */
.view-tab.-active {
    background: $surface;
}

.view-tab-sep {
    width: auto;
    color: $text-muted;
}

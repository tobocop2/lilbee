ForkPicker {
    align: center middle;
}

ForkPicker #fork-root {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: $rail-heavy $primary;
    background: $surface;
    padding: 1 2;
}

ForkPicker #fork-title {
    text-style: bold;
    width: 100%;
    content-align: center middle;
    color: $text;
    margin-bottom: 1;
}

ForkPicker #fork-list {
    width: 100%;
    height: auto;
    max-height: 20;
    background: transparent;
    border: none;
    padding: 0;
}

ForkPicker #fork-list > .option-list--option {
    padding: 0 1;
}

ForkPicker #fork-list > .option-list--option-highlighted {
    background: $primary 25%;
}

ForkPicker #fork-hint {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
    margin-top: 1;
}

FleetBody {

    #placement-layout {
        height: 1fr;
        padding: 0 1;
    }

    #placement-titlebar {
        height: 1;
        margin-bottom: 1;
    }

    #placement-title {
        width: 1fr;
        height: 1;
    }

    /* One hover-help for the whole drawer; keeps the surface otherwise minimal. */
    #placement-help {
        width: 3;
        height: 1;
        content-align: right middle;
        color: $primary;
        text-style: bold;
    }

    #placement-editor {
        height: auto;
    }

    .role-row {
        height: 1;
    }

    .role-name {
        width: 9;
        content-align: left middle;
    }

    /* GPU slots are one-line toggle pills: the fill carries the state and the
       keyboard cursor rides the text style, so a role costs one row. */
    .dev-toggle {
        width: 5;
        height: 1;
        margin: 0 1 0 0;
        content-align: center middle;
        background: $surface;
        color: $text-muted;
        text-style: none;
    }

    .dev-toggle:hover {
        background: $boost;
        color: $foreground;
    }

    /* Focused (keyboard) pill: reverse marks the cursor on top of the state
       fill, so focus layers on state instead of masking it. */
    .dev-toggle:focus {
        text-style: bold reverse;
    }

    /* On-state color carries the KIND: split (one model across cards) = primary,
       mirror (a copy per card) = secondary, single (one pinned card) = accent. */
    .dev-toggle.split.on {
        background: $primary;
        color: $background;
        text-style: bold;
    }

    .dev-toggle.mirror.on {
        background: $secondary;
        color: $background;
        text-style: bold;
    }

    .dev-toggle.single.on {
        background: $accent;
        color: $background;
        text-style: bold;
    }

    .dev-toggle.on:focus {
        text-style: bold reverse;
    }

    .rep-pill {
        width: 5;
        height: 1;
        margin: 0 1 0 0;
        content-align: center middle;
        background: $surface;
        color: $foreground;
    }

    .rep-pill:hover {
        background: $boost;
    }

    .rep-pill:focus {
        text-style: bold reverse;
    }

    .rep-count {
        width: 5;
        content-align: center middle;
    }

    /* Command row: Preview / Apply / Auto as clickable pills so the drawer is
       fully mouse-operable, mirroring the ctrl+r/s/x keys. */
    #placement-commands {
        height: 1;
        margin-top: 1;
    }

    .cmd-pill {
        width: auto;
        min-width: 9;
        height: 1;
        margin: 0 1 0 0;
        padding: 0 1;
        content-align: center middle;
        background: $surface;
        color: $foreground;
        text-style: none;
    }

    .cmd-pill:hover {
        background: $boost;
    }

    .cmd-pill:focus {
        text-style: bold reverse;
    }

    .gpu-header-row {
        height: 1;
    }

    .gpu-hdr-lead {
        width: 9;
        color: $text-muted;
        content-align: left middle;
    }

    .gpu-hdr {
        width: 5;
        margin: 0 1 0 0;
        color: $text-muted;
        content-align: center middle;
    }

    .role-tag {
        width: auto;
        margin-left: 1;
        color: $text-muted;
        content-align: left middle;
    }

    .pager-row {
        height: 1;
        margin-top: 1;
    }

    .pg-pill {
        width: 5;
        height: 1;
        margin: 0 1 0 0;
        content-align: center middle;
        background: $surface;
        color: $foreground;
    }

    .pg-pill:hover {
        background: $boost;
    }

    .pg-pill:focus {
        text-style: bold reverse;
    }

    .pg-info {
        width: auto;
        color: $text-muted;
        content-align: left middle;
    }

    #placement-hint {
        height: auto;
        color: $text-muted;
    }
}

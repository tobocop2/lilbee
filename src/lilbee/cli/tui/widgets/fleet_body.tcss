FleetBody {

    #placement-layout {
        height: 1fr;
        padding: 0 1;
    }

    #placement-titlebar {
        height: 1;
        margin-bottom: 1;
    }

    #placement-title {
        width: 1fr;
        height: 1;
    }

    /* One hover-help for the whole drawer; keeps the surface otherwise minimal. */
    #placement-help {
        width: 3;
        height: 1;
        content-align: right middle;
        color: $primary;
        text-style: bold;
    }

    #placement-editor {
        height: auto;
    }

    .role-row {
        height: 3;
        align-vertical: middle;
    }

    .role-name {
        width: 9;
        content-align: left middle;
    }

    /* GPU slots are toggle chips: a flat themed border carries the state so
       there is no default-Button bevel and no reverse-video focus flash. */
    .dev-toggle {
        min-width: 5;
        width: 5;
        height: 3;
        margin: 0 1 0 0;
        border: round $panel;
        background: $surface;
        color: $text-muted;
        text-style: none;
    }

    .dev-toggle:hover {
        background: $boost;
        color: $foreground;
        border: round $secondary;
    }

    /* Focused (keyboard) chip: keep the state fill (off stays dim) and mark the
       keyboard cursor with a bright iris ring, so focus layers on top of state
       instead of masking it. */
    .dev-toggle:focus {
        background: $boost;
        color: $foreground;
        text-style: bold;
        border: round $primary-lighten-3;
    }

    /* On-state color carries the KIND: split (one model across cards) = primary,
       mirror (a copy per card) = secondary, single (one pinned card) = accent. */
    .dev-toggle.split.on {
        background: $primary;
        color: $background;
        text-style: bold;
        border: round $primary;
    }

    .dev-toggle.mirror.on {
        background: $secondary;
        color: $background;
        text-style: bold;
        border: round $secondary;
    }

    .dev-toggle.single.on {
        background: $accent;
        color: $background;
        text-style: bold;
        border: round $accent;
    }

    .dev-toggle.split.on:focus {
        background: $primary;
        color: $background;
        text-style: bold;
        border: round $primary-lighten-3;
    }

    .dev-toggle.mirror.on:focus {
        background: $secondary;
        color: $background;
        text-style: bold;
        border: round $primary-lighten-3;
    }

    .dev-toggle.single.on:focus {
        background: $accent;
        color: $background;
        text-style: bold;
        border: round $primary-lighten-3;
    }

    .rep-btn {
        min-width: 5;
        width: 5;
        height: 3;
        margin: 0 1 0 0;
        border: round $panel;
        background: $surface;
        color: $foreground;
    }

    .rep-btn:hover {
        background: $boost;
        border: round $secondary;
    }

    .rep-btn:focus {
        background: $surface;
        color: $foreground;
        text-style: bold;
        border: round $primary;
    }

    .rep-count {
        width: 5;
        content-align: center middle;
    }

    /* Command row: Preview / Apply / Auto as clickable buttons so the drawer is
       fully mouse-operable, mirroring the ctrl+r/s/x keys. */
    #placement-commands {
        height: 3;
        margin-top: 1;
    }

    .cmd-btn {
        width: auto;
        min-width: 9;
        height: 3;
        margin: 0 1 0 0;
        border: round $panel;
        background: $surface;
        color: $foreground;
        text-style: none;
    }

    .cmd-btn:hover {
        background: $boost;
        border: round $secondary;
    }

    .cmd-btn:focus {
        background: $boost;
        text-style: bold;
        border: round $primary-lighten-3;
    }

    .gpu-header-row {
        height: 1;
    }

    .gpu-hdr-lead {
        width: 9;
        color: $text-muted;
        content-align: left middle;
    }

    .gpu-hdr {
        width: 5;
        margin: 0 1 0 0;
        color: $text-muted;
        content-align: center middle;
    }

    .role-tag {
        width: auto;
        margin-left: 1;
        color: $text-muted;
        content-align: left middle;
    }

    .pager-row {
        height: 3;
        align-vertical: middle;
        margin-top: 1;
    }

    .pg-btn {
        min-width: 5;
        width: 5;
        height: 3;
        margin: 0 1 0 0;
        border: round $panel;
        background: $surface;
        color: $foreground;
    }

    .pg-btn:hover {
        border: round $secondary;
    }

    .pg-btn:focus {
        text-style: bold;
        border: round $primary-lighten-3;
    }

    .pg-info {
        width: auto;
        color: $text-muted;
        content-align: left middle;
    }

    #placement-hint {
        height: auto;
        color: $text-muted;
    }
}

ModelCard {
    height: auto;
    border: round $primary 50%;
    background: $boost;
    padding: 0 1;
    margin: 0 0;
    pointer: pointer;

    &:hover {
        background: $surface;
        border: round $accent;
    }

    &.-highlight {
        border: round $accent;
        background: $surface;
    }

    .card-body {
        width: 1fr;
    }
}

ModelCard {
    height: auto;
    border: solid $secondary 50%;
    padding: 0 1;
    pointer: pointer;

    &:hover {
        background: $surface;
        border: solid $accent;
    }

    /* Mirror the list-view highlight: background fill plus accent border
     * so the focused card reads as a clearly separated, selected tile. */
    &.-highlight {
        background: $primary 30%;
        border: solid $accent;
    }

    &:focus, &:focus-within {
        background: $primary 30%;
        border: solid $accent;
    }

    .card-body {
        width: 1fr;
    }
}

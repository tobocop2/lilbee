ScopeChip {
    height: 1;
    width: auto;
    padding: 0;
    margin: 0 2 0 0;
    background: transparent;
}

ScopeChip.-hidden {
    display: none;
}

ScopeChip #scope-chip-pill {
    width: auto;
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text-muted;
}

ScopeChip:hover #scope-chip-pill {
    color: $text;
}

ScopeChip:focus #scope-chip-pill {
    background: $success;
    color: $text;
}

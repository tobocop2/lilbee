ScopeChip {
    height: 1;
    width: auto;
    padding: 0;
    margin: 0 2 0 0;
    background: transparent;
}

ScopeChip.-hidden {
    display: none;
}

ScopeChip Horizontal {
    height: 1;
    width: auto;
}

ScopeChip .scope-pill {
    width: auto;
    height: 1;
    padding: 0 1;
    margin: 0 1 0 0;
    background: $boost;
    color: $text-muted;
}

ScopeChip .scope-pill.-active {
    background: $success;
    color: $text;
}

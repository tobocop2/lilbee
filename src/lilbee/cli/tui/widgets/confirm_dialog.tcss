ConfirmDialog {
    align: center middle;
}

ConfirmDialog > Vertical {
    width: 60;
    height: auto;
    max-height: 14;
    border: $rail-heavy $primary;
    background: $surface;
    padding: 1 2;
}

ConfirmDialog #confirm-title {
    text-style: bold;
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
    color: $text;
}

ConfirmDialog #confirm-message {
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
    color: $text;
}

ConfirmDialog Center {
    width: 100%;
    height: auto;
    margin-top: 1;
}

ConfirmDialog #confirm-buttons {
    width: auto;
    height: 1;
}

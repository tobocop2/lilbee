SlashCommandCatalog {
    align: center middle;
}

SlashCommandCatalog #catalog-root {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: $rail-heavy $primary;
    background: $surface;
    padding: 1 2;
}

SlashCommandCatalog #catalog-title {
    text-style: bold;
    width: 100%;
    content-align: center middle;
    color: $text;
    margin-bottom: 1;
}

SlashCommandCatalog #catalog-filter {
    width: 100%;
    margin-bottom: 1;
    border: round $primary 40%;
    background: $boost;
}

SlashCommandCatalog #catalog-filter:focus {
    border: round $primary;
}

SlashCommandCatalog #catalog-list {
    width: 100%;
    height: auto;
    max-height: 100%;
    min-height: 5;
    margin-bottom: 1;
    background: transparent;
    border: none;
    padding: 0;
}

SlashCommandCatalog #catalog-list > .option-list--option {
    padding: 0 1;
}

SlashCommandCatalog #catalog-list > .option-list--option-disabled {
    color: $primary;
    text-style: bold;
    padding: 1 0 0 0;
    background: transparent;
}

SlashCommandCatalog #catalog-list > .option-list--option-highlighted {
    background: $primary 25%;
}

/* Docked, so the list gives up its rows and the footer and Close stay in view. */
SlashCommandCatalog #catalog-footer {
    dock: bottom;
    height: 1;
}

SlashCommandCatalog #catalog-hint {
    content-align: center middle;
    color: $text-muted;
}

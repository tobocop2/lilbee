SearchHFCtaItem {
    height: auto;
    padding: 0 1;
    margin: 1 0 0 0;
    border-left: heavy transparent;
    pointer: pointer;
    color: $accent;
    text-style: bold;

    &:hover {
        background: $surface;
    }

    &:focus {
        border-left: heavy $accent;
        background: $surface;
    }

    #cta-label {
        width: 1fr;
        height: 1;
    }
}

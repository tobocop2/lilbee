ModelBar {
    height: auto;
    padding: 0;
    background: transparent;
}

ModelBar Horizontal {
    height: 1;
    width: 100%;
}

ModelBar .model-bar-pill {
    width: auto;
    padding: 0 1 0 0;
}

ModelBar Select {
    width: 1fr;
    height: 1;
    max-height: 1;
    margin: 0 1 0 0;
    border: none;
    padding: 0;
}

ModelBar Select:focus {
    border: none;
}

ModelBar Select > SelectCurrent {
    height: 1;
    padding: 0 1;
    border: none;
}

ModelBar Select:focus > SelectCurrent {
    border: none;
    background: $primary 30%;
    color: $text;
    text-style: bold;
}

ModelBar Select > SelectOverlay {
    max-height: 12;
    constrain: inflect inflect;
}

ModelBar .cloud-warning {
    display: none;
    color: $warning;
    text-style: bold;
    padding: 0 1;
}

ModelBar .cloud-warning.-visible {
    display: block;
}

ModelBar #chat-mode-toggle {
    width: auto;
    height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    text-style: bold;
}

ModelBar #chat-mode-toggle:focus {
    text-style: bold reverse;
}

ModelBar #chat-mode-toggle.-disabled {
    color: $text 40%;
    text-style: dim;
}

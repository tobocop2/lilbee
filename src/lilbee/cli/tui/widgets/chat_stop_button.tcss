ChatStopButton {
    width: auto;
    height: 1;
    padding: 0 1;
    background: $error;
    color: $text;
    text-style: bold;
    border: none;
}

ChatStopButton:focus {
    background: $error-lighten-1;
    text-style: bold reverse;
}

ChatStopButton:hover {
    background: $error-lighten-1;
}

/* 1fr, not 100%: the hint shares its row with the context chip, and 100% would
 * claim the whole width and squeeze the chip out. */
HelpHint {
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text;
    content-align: left middle;
}

HelpHint:hover {
    background: $primary 25%;
    text-style: bold;
}

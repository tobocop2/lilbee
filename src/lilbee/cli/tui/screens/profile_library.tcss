ProfileLibrary {
    align: center middle;
}

#library-body {
    width: 80%;
    max-width: 100;
    height: 80%;
    max-height: 28;
}

ProfileLibrary.-narrow #library-body {
    width: 100%;
    height: 100%;
}

#library-main {
    height: 1fr;
    min-height: 0;
}

#library-list {
    width: 3fr;
    height: 100%;
}

#library-detail {
    width: 2fr;
    height: 100%;
    padding: 0 0 0 2;
}

ProfileLibrary.-narrow #library-detail {
    display: none;
}

#library-name {
    text-style: bold;
}

.library-muted {
    color: $text-muted;
}

#library-problem {
    color: $warning;
}

#library-changes {
    height: auto;
    max-height: 10;
}

#library-hints {
    dock: bottom;
    height: auto;
    margin-top: 1;
}

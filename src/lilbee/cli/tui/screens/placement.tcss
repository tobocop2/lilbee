PlacementScreen {

    #placement-layout {
        height: 1fr;
        padding: 0 1;
    }

    #placement-title {
        height: 1;
        margin-bottom: 1;
    }

    #placement-gpus {
        height: auto;
        max-height: 12;
        border: solid $surface-lighten-2;
        margin-bottom: 1;
    }

    #placement-editor {
        height: auto;
    }

    .role-row {
        height: 3;
        align-vertical: middle;
    }

    .role-name {
        width: 9;
        content-align: left middle;
    }

    /* GPU slots are flat filled chips: the background carries the state, so there
       are no box-drawing borders to render as broken dashes in a recording. */
    .dev-toggle {
        min-width: 5;
        width: 5;
        height: 3;
        margin: 0 1 0 0;
        border: none;
        background: $panel;
        color: $text-muted;
        text-style: none;
        content-align: center middle;
    }

    .dev-toggle:hover {
        background: $boost;
        color: $foreground;
    }

    .dev-toggle:focus {
        background: $boost;
        color: $foreground;
        text-style: bold;
    }

    .dev-toggle.on {
        background: $secondary;
        color: $background;
        text-style: bold;
    }

    .dev-toggle.on:hover {
        background: $secondary-darken-1;
    }

    .dev-toggle.on:focus {
        background: $secondary;
        color: $background;
        text-style: bold;
    }

    .rep-btn {
        min-width: 5;
        width: 5;
        height: 3;
        margin: 0 1 0 0;
        border: none;
        background: $panel;
        color: $foreground;
        content-align: center middle;
    }

    .rep-btn:hover {
        background: $boost;
    }

    .rep-btn:focus {
        background: $boost;
        text-style: bold;
    }

    .rep-count {
        width: 5;
        content-align: center middle;
    }

    #placement-generated {
        height: auto;
        margin-top: 1;
        color: $text-muted;
    }

    #placement-hint {
        height: auto;
        color: $text-muted;
    }
}

/* Setup wizard — mirrors the catalog's grid aesthetic. */

#setup-title {
    text-style: bold;
    text-align: center;
    padding: 1 0 0 0;
}

#setup-intro {
    color: $text-muted;
    padding: 0 4 1 4;
    text-align: center;
}

#setup-grid-container {
    height: 1fr;
    padding: 0 1;
}

/* setup-enter-hint lives inside the BottomBars wrapper; docking directly
 * here would overlap with the TaskBar above the Footer (see BottomBars
 * docstring). Height includes the border row, so height: 1 + border-top
 * would leave zero rows for the text and render blank. */
#setup-enter-hint {
    height: 1;
    width: 100%;
    text-align: center;
    color: $primary;
    text-style: italic;
    padding: 0 2;
}

/* Setup-wizard cards inherit ModelCard's catalog styling (tall $secondary 50%
 * border, $accent focus/hover) verbatim; only the wizard-specific "-selected"
 * state overlays an extra cue so the picked card reads as committed. */

ModelCard.-selected {
    background: $primary 30%;
    border: tall $accent;
}

GridSelect:focus ModelCard.-highlight.-selected {
    background: $primary 30%;
    border: tall $accent;
}

GridSelect:focus ModelCard.-highlight #card-hint {
    color: $primary;
    text-style: bold italic;
}

.section-heading {
    text-style: bold;
    color: $primary;
    padding: 1 1 0 2;
    border-bottom: solid $surface-lighten-2;
}

GridSelect {
    height: auto;
    padding: 0;
    margin: 0 1;
    grid-gutter: 1;
    border: round $secondary 50%;
    keyline: none;

    &.-highlight {
        background: $surface;
        border: tall $primary 30%;
    }

    &:focus * {
        &.-highlight {
            background: $surface;
            border: tall $primary;
        }
    }
}

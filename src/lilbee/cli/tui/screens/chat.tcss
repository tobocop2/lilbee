#chat-log {
    height: 1fr;
    align: left bottom;
}

ChatWelcome {
    width: 100%;
    height: auto;
    padding: 4 0;
    content-align: center middle;
    color: $text-muted;
}

.user-message {
    border-left: thick $primary;
    padding: 0 1;
    margin: 1 0 0 0;
    height: auto;
}

.assistant-message {
    border-left: thick $success;
    padding: 0 1;
    height: auto;
}

.speaker-label {
    height: auto;
}

.source-citation {
    padding: 0 1;
    color: $text-muted;
}

.section-header {
    text-style: bold underline;
    color: $text-muted;
    padding: 1 0 0 1;
}

Markdown {
    background: transparent;
    margin: 0 1;
}

#chat-input {
    border: none;
}

#chat-input.normal-mode {
    opacity: 0.7;
}

#chat-only-banner {
    height: 1;
    padding: 0 1;
    background: $warning;
    color: $text;
    text-style: bold;
}

/* The prompt block wraps the input AND the model strip so they share a single
 * focus border. Children (input on top, model strip below) read as one zone. */
#chat-prompt-area {
    height: auto;
    padding: 0 1;
    border: tall transparent;
}

#chat-prompt-area:focus-within {
    border: tall $primary;
}

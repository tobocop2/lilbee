#chat-log {
    height: 1fr;
    align: left bottom;
}

ChatWelcome {
    width: 100%;
    height: auto;
    padding: 4 0;
    content-align: center middle;
    color: $text-muted;
}

.user-message {
    border-left: solid $surface-lighten-2;
    padding: 0 1;
    margin: 1 0 0 0;
    height: auto;
}

.assistant-message {
    border-left: solid $surface-lighten-2;
    padding: 0 1;
    height: auto;
}

.speaker-label {
    height: auto;
}

.source-citation {
    padding: 0 1;
    color: $text-muted;
}

.section-header {
    text-style: bold underline;
    color: $text-muted;
    padding: 1 0 0 1;
}

Markdown {
    background: transparent;
    margin: 0 1;
}

/* ChatInput is a TextArea subclass. The default height keeps a comfortable
 * three-row pad (one row text, one row top/bottom padding) so the input
 * never feels cramped. _track_multiline toggles -multiline when the user
 * adds a newline; the input then grows up to 10 rows. */
#chat-input {
    border: none;
    height: 3;
    padding: 1 1;
    margin: 0;
    background: $surface;
}

#chat-input.-multiline {
    height: auto;
    min-height: 3;
    max-height: 10;
}

#chat-input.normal-mode {
    opacity: 0.7;
}

/* The prompt block wraps the input AND the model strip so they share a single
 * focus border. Children (input on top, model strip below) read as one zone. */
#chat-prompt-area {
    height: auto;
    padding: 0 1;
    border: tall transparent;
}

#chat-prompt-area:focus-within {
    border: tall $primary;
}

/* Catalog screen — grid and list views */

#catalog-tabs {
    height: 1fr;
    min-height: 0;
}

/* TabbedContent's inner ContentSwitcher and TabPane default to height: auto,
 * which lets a tall TabPane body push the docked BottomBars off-screen.
 * Force them to flex instead so the dock-bottom reservation always wins.
 */
#catalog-tabs ContentSwitcher,
#catalog-tabs TabPane {
    height: 1fr;
    min-height: 0;
}

#catalog-toolbar {
    height: 1;
    width: 100%;
}

#catalog-grid {
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    padding: 0 1;
}

ModelGrid {
    height: auto;
    min-height: 6;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0 1;
}

ModelGrid:focus {
    border: none;
    background: $surface 30%;
}

#catalog-list {
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    padding: 0 1;
}

#sort-label {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#catalog-loading-spinner {
    height: 1;
    width: auto;
    padding: 0 1;
    color: $primary;
    text-style: bold;
    display: none;
}

#catalog-search {
    margin: 0 1;
}

#catalog-search.-hidden {
    display: none;
}

#model-detail {
    height: 6;
    padding: 1;
    border-top: solid $surface-lighten-2;
}

.section-heading {
    text-style: bold;
    color: $primary;
    padding: 1 1 0 2;
    border-bottom: solid $surface-lighten-2;
}

CatalogScreen.-grid-view #catalog-list { display: none; }
CatalogScreen.-grid-view #sort-label { display: none; }
CatalogScreen.-grid-view #model-detail { display: none; }
CatalogScreen.-grid-view #catalog-list-footer { display: none; }
CatalogScreen.-list-view #catalog-grid { display: none; }
CatalogScreen.-list-view #catalog-list-footer { display: block; }

#catalog-list-footer {
    height: auto;
    padding: 0 2;
    margin: 0 2;
    text-align: center;
    color: $text-muted;
}

GridSelect {
    height: auto;
    padding: 0;
    margin: 0 1;
    grid-gutter: 1;
    border: round $secondary 50%;
    keyline: none;

    &.-highlight {
        background: $surface;
        border: tall $primary 30%;
    }

    &:focus * {
        &.-highlight {
            background: $surface;
            border: tall $primary;
        }
    }
}

.grid-cta {
    text-align: center;
    text-style: bold;
    padding: 1 2;
    margin: 1 2;
    border: tall $surface-lighten-2;
    color: $text;
}

.search-hf-cta {
    color: $accent;
}

.search-hf-cta:hover {
    background: $surface;
    border: tall $accent;
}

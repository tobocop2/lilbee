StartupGate {
    align: center middle;
}

#gate-body {
    width: auto;
    max-width: 100%;
    height: auto;
    align: center middle;
}

/* Bright rose, xterm-256 index 217 (ROSE_BRIGHT_XTERM in runtime/bee_logo.py),
   the 256-color match for the site's rose-pine accent. The wordmark bleeds from
   the bootstrap's dim rose to this once the TUI owns the screen.
   tests/test_startup_gate.py pins the two together. */
#gate-logo {
    width: 100%;
    content-align-horizontal: center;
    color: #ffafaf;
    text-style: bold;
}

/* The bar carries the same rose ramp as the bootstrap's blocks: a bright fill,
   a mid-rose sweep while indeterminate, and a dim-rose trough. Every hex is the
   xterm index in runtime/bee_logo.py; tests/test_startup_gate.py pins them. */
#gate-bar {
    width: 100%;
    align-horizontal: center;
    margin: 1 0 0 0;
}

#gate-bar Bar > .bar--bar {
    color: #ffafaf;
    background: #875f5f;
}

#gate-bar Bar > .bar--indeterminate {
    color: #d7afaf;
    background: #875f5f;
}

#gate-bar PercentageStatus {
    color: #d7afaf;
}

/* A fixed size, so a longer status line never moves the wordmark and bar: the
   upgrade's headline and progress line take at most three rows at 70 columns
   and wider. A narrower terminal grows the box rather than cut the text. */
#gate-status {
    width: 96;
    max-width: 100%;
    height: auto;
    min-height: 3;
    text-align: center;
    margin: 1 0 0 0;
    color: $text-muted;
}

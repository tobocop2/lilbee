ConfirmUnsupportedModal {
    align: center middle;
}

#confirm-unsupported-root {
    background: $surface;
    border: round $warning;
    padding: 1 2;
    width: 60;
    height: auto;
}

#confirm-unsupported-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

#confirm-unsupported-body {
    margin-bottom: 1;
}

#confirm-unsupported-actions {
    align-horizontal: right;
    height: auto;
}

#confirm-unsupported-cancel {
    margin-right: 1;
}

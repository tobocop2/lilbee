SettingsScreen {

    #settings-scroll {
        height: 1fr;
        min-height: 0;
        padding: 0 1;
    }

    #settings-tabs {
        height: 1fr;
        min-height: 0;
        margin-top: 1;
    }

    /* TabbedContent's inner ContentSwitcher and TabPane default to
     * height: auto. With a tall settings group (Ingest, Generation) that
     * pushes the docked BottomBars off-screen. Force flex so the
     * dock-bottom reservation always wins.
     */
    #settings-tabs ContentSwitcher,
    #settings-tabs TabPane {
        height: 1fr;
        min-height: 0;
    }

    /* Settings sub-tabs adopt the same look as the top ViewTabs strip:
     * active tab is bold + underlined in $accent regardless of focus,
     * inactive tabs stay dim. Two navigation levels speak the same
     * dialect, no separate "focused vs unfocused active" treatment.
     */
    #settings-tabs Tab {
        padding: 0 2;
        color: $text-muted;
    }
    #settings-tabs Tab.-active {
        color: $accent;
        text-style: bold underline;
        background: transparent;
    }
    #settings-tabs Tabs:focus Tab.-active {
        color: $accent;
        text-style: bold underline;
    }
    #settings-tabs Underline {
        color: $accent;
    }

    .api-keys-warning {
        color: $warning;
        text-style: italic;
        padding: 0 0 1 1;
    }

    .setting-row {
        margin-bottom: 1;

        &:last-child {
            margin-bottom: 0;
        }
    }

    .setting-title {
        padding: 0 0 0 1;
        text-style: bold;
    }

    .setting-help {
        color: $text-muted;
        padding: 0 0 0 1;
    }

    .setting-editor {
        margin: 0 0 0 0;
    }

    .setting-editor-row {
        layout: horizontal;
        height: auto;
    }

    .setting-editor-row .setting-editor {
        width: 1fr;
    }

    .setting-reset-button {
        width: 3;
        min-width: 3;
        margin-left: 1;
        color: $text-muted;
    }

    .setting-model-picker-button {
        width: 1fr;
        height: 3;
        background: $boost;
        color: $text;
        border: tall $surface-lighten-2;
        text-style: bold;

        &:focus {
            border: tall $primary;
        }
    }

    Input, Select SelectCurrent, Checkbox {
        border: tall $surface-lighten-2;

        &:focus {
            border: tall $primary;
        }
    }

    Select:focus > SelectCurrent {
        border: tall $primary;
    }

    Input.-invalid {
        border: tall $error 60%;
    }

    .setting-list-editor {
        height: 16;
        border: solid $surface;
        margin-bottom: 1;
    }

    .setting-multiline-editor {
        height: 12;
        border: solid $surface-lighten-2;
        margin-bottom: 1;

        &:focus-within {
            border: tall $primary;
        }
    }

    .setting-list-error {
        color: $error;
        display: none;
    }

    .setting-list-error.-visible {
        display: block;
    }

    .setting-list-restore {
        margin-top: 1;
    }
}

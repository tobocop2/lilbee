SettingsScreen {
    #settings-top-row {
        height: auto;
        margin: 0 1;
    }

    .reset-all-button {
        width: auto;
        margin-left: 1;
        color: $text-muted;
    }

    #settings-scroll {
        padding: 0 1;
    }

    /* TabbedContent focus highlight: bold text + accent underline on
     * the active group-tab when the Tabs widget has focus. Default
     * Textual styling shows the active tab in $primary; we lift
     * contrast further so keyboard users can see the focus ring.
     */
    #settings-tabs Tabs:focus .-active {
        text-style: bold underline;
        color: $accent;
    }
    #settings-tabs Tabs:focus Tab.-active {
        text-style: bold underline;
        color: $accent;
    }

    .api-keys-warning {
        color: $warning;
        text-style: italic;
        padding: 0 0 1 1;
    }

    .setting-row {
        margin-bottom: 1;

        &:last-child {
            margin-bottom: 0;
        }
    }

    .setting-title {
        padding: 0 0 0 1;
        text-style: bold;
    }

    .setting-help {
        color: $text-muted;
        padding: 0 0 0 1;
    }

    .setting-editor {
        margin: 0 0 0 0;
    }

    .setting-editor-row {
        layout: horizontal;
        height: auto;
    }

    .setting-editor-row .setting-editor {
        width: 1fr;
    }

    .setting-reset-button {
        width: 3;
        min-width: 3;
        margin-left: 1;
        color: $text-muted;
    }

    Input, Select SelectCurrent, Checkbox {
        border: tall $surface-lighten-2;

        &:focus {
            border: tall $primary;
        }
    }

    Select:focus > SelectCurrent {
        border: tall $primary;
    }

    Input.-invalid {
        border: tall $error 60%;
    }

    .setting-list-editor {
        height: 16;
        border: solid $surface;
        margin-bottom: 1;
    }

    .setting-list-error {
        color: $error;
        display: none;
    }

    .setting-list-error.-visible {
        display: block;
    }

    .setting-list-restore {
        margin-top: 1;
    }
}

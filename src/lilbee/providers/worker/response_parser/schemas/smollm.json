{
  "x-regex": "(?:<think>\\n?(?P<thinking>.+?)\\n?</think>)?\\s*(?:<tool_call>(?P<tool_calls>.+?)</tool_call>)?\\s*(?P<content>.+?)?\\s*(?:<\\|im_end\\|>|$)",
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "content": {
      "type": "string"
    },
    "thinking": {
      "type": "string"
    },
    "tool_calls": {
      "x-parser": "json",
      "x-parser-args": {
        "transform": "[{type: 'function', function: @}]"
      },
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "function"
          },
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          }
        }
      }
    }
  }
}

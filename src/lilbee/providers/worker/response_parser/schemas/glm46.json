{
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "thinking": {
      "type": "string",
      "x-regex": "<think>\\s*(.*?)\\s*</think>"
    },
    "content": {
      "type": "string",
      "x-regex-substitutions": [
        ["<think>.*?</think>", ""],
        ["<tool_call>.*?</tool_call>", ""]
      ],
      "x-regex": "^\\s*(.*?)\\s*$"
    },
    "tool_calls": {
      "x-regex-iterator": "<tool_call>\\s*(.*?)\\s*</tool_call>",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "x-regex": "^\\s*([^\\n<]+?)\\s*(?:\\n|<arg_key>)"
          },
          "arguments": {
            "type": "object",
            "x-regex-key-value": "<arg_key>\\s*(?P<key>.*?)\\s*</arg_key>\\s*<arg_value>\\s*(?P<value>.*?)\\s*</arg_value>",
            "additionalProperties": {
              "x-parser": "json",
              "x-parser-args": {"allow_non_json": true}
            }
          }
        }
      }
    }
  }
}

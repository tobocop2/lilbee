{
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "content": {
      "type": "string",
      "x-regex": "<\\|START_RESPONSE\\|>(.*?)(?:<\\|END_RESPONSE\\|>|$)"
    },
    "thinking": {
      "type": "string",
      "x-regex": "<\\|START_THINKING\\|>(.*?)(?:<\\|END_THINKING\\|>|$)"
    },
    "tool_calls": {
      "x-regex": "<\\|START_ACTION\\|>(.*?)(?:<\\|END_ACTION\\|>|$)",
      "x-parser": "json",
      "x-parser-args": {
        "transform": "[*].{type: 'function', function: {name: tool_name, arguments: parameters}}"
      },
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "function"
          },
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          }
        }
      }
    }
  }
}

{
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "content": {
      "type": "string",
      "x-regex": "^(.*?)(?:<\\|tool_call\\|>|<tool_call>|$)"
    },
    "tool_calls": {
      "type": "array",
      "x-regex": "(?:<\\|tool_call\\|>|<tool_call>)\\s*(\\[.*\\])",
      "x-parser": "json",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}

{
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "content": {
      "type": "string",
      "x-regex": "^(.*?)(?:<\\|tool_call\\|>|<tool_call>|\\[\\s*\\{\\s*\"name\"\\s*:|\\{\\s*\"name\"\\s*:|$)"
    },
    "tool_calls": {
      "type": "array",
      "x-regex": "(?:<\\|tool_call\\|>|<tool_call>|(?=\\{\\s*\"name\"))([\\s\\S]*)",
      "x-regex-iterator": "(\\{(?:[^{}]|\\{(?:[^{}]|\\{[^{}]*\\})*\\})*\\})",
      "items": {
        "type": "object",
        "x-parser": "json",
        "properties": {
          "name": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}

{
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "content": {
      "type": "string",
      "x-regex": "^(.*?)(?:<\\|tool_calls_section_begin\\|>|$)"
    },
    "tool_calls": {
      "x-regex-iterator": "<\\|tool_call_begin\\|>\\s*(.*?)\\s*<\\|tool_call_end\\|>",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "x-regex": "^(?:[^.:]*\\.)?([^:]+):\\d+"
          },
          "arguments": {
            "type": "object",
            "x-regex": "<\\|tool_call_argument_begin\\|>\\s*(\\{.*\\})\\s*$",
            "x-parser": "json",
            "additionalProperties": true
          }
        }
      }
    }
  }
}

{
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "content": {
      "type": "string",
      "x-regex": "<\\|channel\\|>final<\\|message\\|>(.*?)(?:<\\|end\\|>|$)"
    },
    "thinking": {
      "type": "string",
      "x-regex": "<\\|channel\\|>analysis<\\|message\\|>(.*?)<\\|end\\|>"
    },
    "tool_calls": {
      "x-regex-iterator": "<\\|channel\\|>commentary (to=functions\\..*?<\\|message\\|>.*?)(?:<\\|call\\|>|$)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "function"
          },
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "x-regex": "^to=functions\\.(\\w+)"
              },
              "arguments": {
                "type": "object",
                "x-regex": "<\\|message\\|>(.*)",
                "x-parser": "json",
                "additionalProperties": {}
              }
            }
          }
        }
      }
    }
  }
}

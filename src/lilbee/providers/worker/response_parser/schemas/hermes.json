{
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "thinking": {
      "type": "string",
      "x-regex": "<scratch_pad>\\s*(.*?)\\s*</scratch_pad>"
    },
    "content": {
      "type": "string",
      "x-regex-substitutions": [
        ["<scratch_pad>.*?</scratch_pad>", ""],
        ["<tool_call>.*?</tool_call>", ""]
      ],
      "x-regex": "^\\s*(.*?)\\s*$"
    },
    "tool_calls": {
      "x-regex-iterator": "<tool_call>\\s*(\\{.*?\\})\\s*</tool_call>",
      "type": "array",
      "items": {
        "type": "object",
        "x-parser": "json",
        "properties": {
          "name": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}

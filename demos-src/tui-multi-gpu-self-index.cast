[66.00445199999999, "o", "\u001b[4;1H\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m\u2502\u001b[39m \u001b[38;2;196;167;231m\u001b[1myou\u001b(B\u001b[m\u001b[48;2;25;23;36m                                                                       \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m \u001b[38;2;224;222;244mWhat is lilbee in one sentence?\u001b[39m                                           \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m \u001b[38;2;156;207;216m\u001b[1mlilbee\u001b(B\u001b[m\u001b[48;2;25;23;36m                                                                    \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244mlilbee is a local search engine for your own documents that runs\u001b[39m       \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244mentirely on your machine, allowing you to index and search files\u001b[39m       \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244mlike markdown, code, PDFs, and more without any data leaving your\u001b[39m      \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244mcomputer [1].\u001b[39m                                                          \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m                                                                           \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244mSources: \u2192\u001b[39m                                                             \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244m~/.local/share/lilbee/documents/lilbee_src/docs/architecture.md\u001b[39m        \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m                                                                           \r\n                                                                            \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m \u001b[38;2;196;167;231m\u001b[1myou\u001b(B\u001b[m\u001b[48;2;25;23;36m                                                                       \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m \u001b[38;2;224;222;244mHow does lilbee run a model too big for one GPU?\u001b[39m                          \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m \u001b[38;2;156;207;216m\u001b[1mlilbee\u001b(B\u001b[m\u001b[48;2;25;23;36m                                                                    \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m  \u001b[32;120H\u001b(B\u001b[m"]
[66.00485800000001, "o", "\u001b[19;4H\u001b[48;2;25;23;36m  \u001b[38;2;224;222;244mlilbee runs a model too big for one GPU by tensor-splitting it\u001b[39m         \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244macross the fewest GPUs necessary so that each device's share of the\u001b[39m    \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244mmodel fits within its VRAM, using first-fit-decreasing bin-packing\u001b[39m     \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244mwith 90%\u001b[39m                                                               \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m                                                                           \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m                                                                           \u001b[32;120H\u001b(B\u001b[m"]

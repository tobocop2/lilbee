[65.45962, "o", "\u001b[20;3H\u001b[48;2;25;23;36m   \u001b[38;2;224;222;244mlilbee runs a model too big for one GPU by tensor-splitting it\u001b[39m         \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244macross the fewest GPUs necessary so that each device's share of the\u001b[39m    \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m    \u001b[38;2;224;222;244mmodel fits within\u001b[39m                                                      \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m                                                                           \r\n\u001b[38;2;63;61;79m\u2502\u001b[39m                                                                           \u001b[32;120H\u001b(B\u001b[m"]

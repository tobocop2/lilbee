Set Shell "bash"
Set Width 1400
Set Height 900
Set FontSize 14
Set Padding 20
Set TypingSpeed 35ms
Set Framerate 25
Set PlaybackSpeed 1
Set Theme "rose-pine-moon"
Set WindowBar Colorful
Env COLORTERM "truecolor"
Env TERM "xterm-256color"
Output reel1.mp4
Output reel1.gif
Hide
Type "source /root/k5_env.sh && lilbee"
Enter
Sleep 80s
Ctrl+g
Sleep 4s
Ctrl+g
Sleep 1s
Show
Sleep 2s
Escape
Sleep 500ms
Type "/add /workspace/corpus"
Sleep 1200ms
Enter
Sleep 2s
Escape
Sleep 600ms
Ctrl+g
Sleep 8s
Sleep 14s
Hide
Sleep 75s
Show
Sleep 2s
Type "i"
Sleep 400ms
Type "How does lilbee place models across GPUs?"
Sleep 1s
Enter
Sleep 38s
Sleep 2s

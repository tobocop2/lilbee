[80.424937, "o", "\u001b[20;75H\u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244mintegrated graphics in dual-GPU setups [7]. The goal is efficient\u001b[39m    \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244mutilization while ensuring models run reliably.\u001b[39m                      \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m                                                                         \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244mSources: →\u001b[39m                                                           \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \u001b[27;3H\u001b[39m\u001b[48;2;31;29;46m \u001b[38;2;25;23;36m\u001b[48;2;244;237;232mA\u001b[38;2;120;119;129m\u001b[48;2;31;29;46msk…   /  commands   F1  keys   F2  all commands\u001b[39m                      \u001b[32;1H\u001b[38;2;235;188;186m\u001b[1m ^c \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;31;29;46mQuit \u001b[38;2;235;188;186m\u001b[1m tab \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;31;29;46mComplete \u001b[38;2;235;188;186m\u001b[1m / \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;31;29;46mSlash commands \u001b[38;2;235;188;186m\u001b[1m esc \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;31;29;46mNormal mode \u001b[38;2;235;188;186m\u001b[1m f2 \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;31;29;46mAl\u001b[38;2;69;67;85m▏\u001b[38;2;235;188;186m\u001b[1m^p\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;31;29;46m palette\u001b[39m \u001b[43C\u001b(B\u001b[m"]
[80.448261, "o", "\u001b[2;6H\u001b[38;2;216;196;239m\u001b[48;2;25;23;36m 1. \u001b[38;2;224;222;244m\u001b[1mEstimate VRAM footprint\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m: Each model's memory requirement is\u001b[39m  \u001b[3;6H\u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mestimated from GGUF metadata.\u001b[39m                                \u001b[4;6H\u001b[38;2;216;196;239m 2. \u001b[38;2;224;222;244m\u001b[1mSort models\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m: Models are sorted by their VRAM footprint in\u001b[39m    \u001b[5;6H\u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mdecreasing order.\u001b[39m                                            \u001b[6;6H\u001b[38;2;216;196;239m 3. \u001b[38;2;224;222;244m\u001b[1mPlacement logic\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m:\u001b[39m                                             \u001b[7;6H\u001b[38;2;216;196;239m    • \u001b[38;2;224;222;244mIf a model fits within the available VRAM of a single GPU,\u001b[39m \u001b[8;6H\u001b[38;2;216;196;239m      \u001b[38;2;224;222;244mit is assigned to that GPU (possibly sharing with smaller\u001b[39m  \u001b[9;6H\u001b[38;2;216;196;239m      \u001b[38;2;224;222;244mmodels).\u001b[39m                                                   \u001b[10;6H\u001b[38;2;216;196;239m    • \u001b[38;2;224;222;244mIf a model is too large for any single GPU, it is\u001b[39m          \u001b[11;6H\u001b[38;2;216;196;239m      \u001b[38;2;224;222;244m\u001b[1mtensor-split\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m across multiple GPUs—the fewest necessary such\u001b[12;6H\u001b[38;2;216;196;239m      \u001b[38;2;224;222;244mthat each shard fits within 90% of individual GPU capacity\u001b[39m \u001b[13;6H\u001b[38;2;216;196;239m      \u001b[38;2;224;222;244m[3].\u001b[39m                                                       \u001b[14;6H\u001b[38;2;216;196;239m 4. \u001b[38;2;224;222;244m\u001b[1mMulti-GPU support\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m: For systems with multiple NVIDIA GPUs,\u001b[39m    \u001b[15;6H\u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mtotal memory from all cards is considered for tensor-split\u001b[39m   \u001b[16;6H\u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mplacement, while decisions about single-GPU fit are based on\u001b[39m \u001b[17;6H\u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mthe smallest card's VRAM [2].\u001b[39m                                \u001b[19;6H\u001b[38;2;224;222;244mAdditionally, users can constrain which GPUs are used via the\u001b[39m    \u001b[20;6H\u001b[38;2;238;205;158m\u001b[48;2;42;36;42mgpu_devices\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m config setting to avoid issues like OOMs on\u001b[39m          \u001b[21;6H\u001b[38;2;224;222;244mintegrated graphics in dual-GPU setups [7]. The goal is efficient\u001b[22;6Hutilization while ensuring models run reliably.\u001b[39m                  \u001b[24;6H\u001b[38;2;224;222;244mSources: →\u001b[39m                                     \u001b[32;120H\u001b(B\u001b[m\u001b[24;53H\u001b[48;2;25;23;36m                  \u001b[32;120H\u001b(B\u001b[m"]

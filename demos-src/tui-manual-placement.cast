[80.344186, "o", "\u001b[22;1H\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244mutilization while ensuring models run reliably.\u001b[39m                      \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m                                                                         \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244mSources: →\u001b[39m                                                           \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;196;167;231m\u001b[48;2;25;23;36m\u001b[7m▊\u001b(B\u001b[m\u001b[38;2;196;167;231m\u001b[48;2;25;23;36m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▎\r\n\u001b[7m▊\u001b(B\u001b[m\u001b[48;2;25;23;36m \u001b[48;2;31;29;46m                                                                        \u001b[48;2;25;23;36m \u001b[38;2;196;167;231m▎\r\n\u001b[7m▊\u001b(B\u001b[m\u001b[48;2;25;23;36m \u001b[48;2;31;29;46m \u001b[38;2;120;119;129mAsk…   /  commands   F1  keys   F2  all commands\u001b[39m                       \u001b[48;2;25;23;36m \u001b[38;2;196;167;231m▎\r\n\u001b[7m▊\u001b(B\u001b[m\u001b[48;2;25;23;36m \u001b[48;2;31;29;46m                                                                        \u001b[48;2;25;23;36m \u001b[38;2;196;167;231m▎\r\n\u001b[7m▊\u001b(B\u001b[m\u001b[48;2;25;23;36m \u001b[38;2;0;0;0m\u001b[48;2;196;167;231m Chat \u001b[39m\u001b[48;2;25;23;36m \u001b[38;2;225;224;226mQwen3 235B A22B\u001b[39m  \u001b[38;2;255;255;255m\u001b[48;2;49;116;143m Embed \u001b[39m\u001b[48;2;25;23;36m \u001b[38;2;225;224;226mnomic text v1.5\u001b[39m  \u001b[38;2;255;255;255m\u001b[48;2;63;61;79m Vision \u001b[39m\u001b[48;2;25;23;36m \u001b[38;2;163;162;167mdisabled\u001b[39m  \u001b[38;2;255;255;255m\u001b[48;2;63;61;79m Rer\u001b[39m\u001b[48;2;25;23;36m \u001b[38;2;196;167;231m▎\r\n\u001b[7m▊\u001b(
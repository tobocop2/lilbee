[79.926514, "o", "\u001b[2;1H\u001b[48;2;25;23;36m                                                                          \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m \u001b[38;2;196;167;231m\u001b[1myou\u001b(B\u001b[m\u001b[48;2;25;23;36m                                                                     \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m \u001b[38;2;224;222;244mw does lilbee pace models across GPUs?\u001b[39m                                  \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m \u001b[38;2;156;207;216m\u001b[1mlilbee\u001b(B\u001b[m\u001b[48;2;25;23;36m                                                                  \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244mLilbee places models across GPUs using a \u001b[1mVRAM-aware bin-packing\u001b(B\u001b[m\u001b[48;2;25;23;36m      \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244m\u001b[1malgorithm\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m called \u001b[7mfirst-fit-decreasing\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m with 90% headroom per GPU,\u001b[39m     \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244mas described in [3] and [5].\u001b[39m                                         \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m                                                                         \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244mHere’s how it works:\u001b[39m                                                 \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m                                                                         \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m 1. \u001b[38;2;224;222;244m\u001b[1mEstimate VRAM footprint\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m: Each model's memory requirement is\u001b[39m      \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mestimated from GGUF metadata.\u001b[39m                                    \u001b[32;120H\u001b(B\u001b[m\u001b[13;75H\u001b[38;2;82;66;105m\u001b[48;2;25;23;36m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m 2. \u001b[38;2;224;222;244m\u001b[1mSort models\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m: Models are sorted by their VRAM footprint in\u001b[39m        \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mdecreasing order.\u001b[39m                                                \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m 3. \u001b[38;2;224;222;244m\u001b[1mPlacement logic\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m:\u001b[39m                                                 \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    • \u001b[38;2;224;222;244mIf a model fits within the available VRAM of a single GPU,\u001b[39m     \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244mit is assigned to that GPU (possibly sharing with smaller\u001b[39m      \u001b[38;2;82;66;105m\u001b[48;2;6;0;21m\u001b[7m▇▇\r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244mmodels).\u001b[39m                                                       \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    • \u001b[38;2;224;222;244mIf a model is too large for any single GPU, it is\u001b[39m              \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244m\u001b[1mtensor-split\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m across multiple GPUs—the fewest necessary such\u001b[39m    \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244mthat each shard fits within 90% of individual GPU capacity\u001b[39m    \u001b[32;120H\u001b(B\u001b[m"]
[79.926634, "o", "\u001b[22;74H\u001b[48;2;25;23;36m \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244m[3].\u001b[39m                                                           \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m 4. \u001b[38;2;224;222;244m\u001b[1mMulti-GPU support\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m: For systems with multiple NVIDIA GPUs,\u001b[39m        \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \u001b[32;120H\u001b(B\u001b[m"]

[80.337418, "o", "\u001b[2;1H\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m 1. \u001b[38;2;224;222;244m\u001b[1mEstimate VRAM footprint\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m: Each model's memory requirement is\u001b[39m      \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mestimated from GGUF metadata.\u001b[39m                                    \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m 2. \u001b[38;2;224;222;244m\u001b[1mSort models\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m: Models are sorted by their VRAM footprint in\u001b[39m        \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mdecreasing order.\u001b[39m                                                \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m 3. \u001b[38;2;224;222;244m\u001b[1mPlacement logic\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m:\u001b[39m                                                 \u001b[38;2;224;222;244m\u001b[48;2;6;0;21m  \r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    • \u001b[38;2;224;222;244mIf a model fits within the available VRAM of a single GPU,\u001b[39m     \u001b[38;2;82;66;105m\u001b[48;2;6;0;21m▅▅\r\n\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244mit is assigned to that GPU (possibly sharing with smaller\u001b[39m      \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244mmodels).\u001b[39m                                                       \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    • \u001b[38;2;224;222;244mIf a model is too large for any single GPU, it is\u001b[39m              \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m  \u001b[32;120H\u001b(B\u001b[m\u001b[11;4H\u001b[48;2;25;23;36m  \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244m\u001b[1mtensor-split\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m across multiple GPUs—the fewest necessary such\u001b[39m    \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244mthat each shard fits within 90% of individual GPU capacity\u001b[39m     \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m      \u001b[38;2;224;222;244m[3].\u001b[39m                                                           \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m 4. \u001b[38;2;224;222;244m\u001b[1mMulti-GPU support\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m: For systems with multiple NVIDIA GPUs,\u001b[39m        \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mtotal memory from all cards is considered for tensor-split\u001b[39m       \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mplacement, while decisions about single-GPU fit are based on\u001b[39m     \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;216;196;239m    \u001b[38;2;224;222;244mthe smallest card's VRAM [2].\u001b[39m                                    \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m                                                                         \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;224;222;244mAdditionally, users can constrain which GPUs are used via the\u001b[39m        \u001b[38;2;82;66;105m\u001b[7m  \r\n\u001b(B\u001b[m\u001b[38;2;63;61;79m\u001b[48;2;25;23;36m│\u001b[39m    \u001b[38;2;238;205;158m\u001b[48;2;42;36;42mgpu_devices\u001b[38;2;224;222;244m\u001b[48;2;25;23;36m config setting to avoid issues like OOMs on\u001b[39m              \u001b[32;120H\u001b(B\u001b[m"]

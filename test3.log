pilot = <Pilot app=FleetTestApp(title='lilbee', classes={'-dark-mode'}, pseudo_classes={'dark', 'focus'})>
selector = '#dev-chat-3'

    async def _toggle_device(pilot, selector: str, *, expect_on: bool = True) -> None:  # type: ignore[no-untyped-def]
        """Click a GPU toggle and wait until the press has been applied.
    
        A single ``pilot.pause()`` can return before the ``Button.Pressed`` message
        is handled under parallel load, leaving the editor spec stale. The handler
        flips the ``on`` class in the same step that mutates the device set, so wait
        for the expected class state as the deterministic post-condition.
        """
        await pilot.click(selector)
        button = pilot.app.screen.query_one(selector, Button)
        for _ in range(100):
            if button.has_class("on") == expect_on:
                return
            await pilot.pause()

"""Architectures the pinned llama.cpp engine can load.

Generated by ``tools/gen_supported_archs.py``; do not edit by hand. Regenerate with
``make engine-archs`` after changing ``ENGINE_LLAMA_CPP_REF``.
"""

from __future__ import annotations

# The engine pin these names were read from, checked against engine-versions.env so
# a bump without a regenerate fails the suite instead of silently going stale.
# The ref is a build-time source coordinate, not a dependency: llama-server is
# compiled from the llama.cpp commit below, cloned from ENGINE_LLAMA_CPP_REPO at
# this ref. lilbee ships no llama.cpp package.
ENGINE_LLAMA_CPP_REF = "{{ ref }}"
LLAMA_CPP_COMMIT = "{{ commit }}"

SUPPORTED_ARCHS: frozenset[str] = frozenset(
    {
    {% for arch in archs %}
        "{{ arch }}",
    {% endfor %}
    }
)

{
    "version": "0.6.90b420.dev734",
    "description": "Run and manage local AI models, then search your files, code, and crawled web pages, with answers that cite the source. One program, no server to run.",
    "homepage": "https://lilbee.sh/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/tobocop2/lilbee/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/tobocop2/lilbee/releases/download/v0.6.90b420.dev734/lilbee-windows-x86_64.exe#/lilbee.exe",
            "hash": "067859d06e4f9fac7f54340bcd1fabdbbdb0b52b482104f0413cd7314fa5009c"
        }
    },
    "bin": "lilbee.exe",
    "post_install": [
        "# Driver 555 is the Windows floor for CUDA 12.5.",
        "# --query-gpu is machine-readable; the header layout is not.",
        "$useCuda = $false",
        "$driver = ''",
        "$smi = Get-Command nvidia-smi -ErrorAction SilentlyContinue",
        "if ($smi) {",
        "    $driver = & nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>$null | Select-Object -First 1",
        "    if ($driver -and \"$driver\".Trim() -match '^(\\d+)') {",
        "        if ([int]$Matches[1] -ge 555) { $useCuda = $true }",
        "    }",
        "}",
        "if ($useCuda) {",
        "    $cudaHash = '60be24fecb04690638330e4acc75efdb25c5940090559222a03fd6d32cb32c8a'",
        "    $url = \"https://github.com/tobocop2/lilbee/releases/download/v$version/lilbee-windows-x86_64-cu125.exe\"",
        "    $exe = Join-Path $dir 'lilbee.exe'",
        "    Write-Host \"lilbee: NVIDIA driver $driver detected, installing the cu125 build\"",
        "    Invoke-WebRequest -Uri $url -OutFile $exe",
        "    $actual = (Get-FileHash $exe -Algorithm SHA256).Hash.ToLower()",
        "    if ($actual -ne $cudaHash) { throw \"lilbee: cu125 checksum mismatch (expected $cudaHash, got $actual)\" }",
        "} elseif ($smi) {",
        "    Write-Host \"lilbee: no NVIDIA driver 555 or newer found (reported: '$driver'), keeping the Vulkan build\"",
        "}"
    ]
}

{
    "version": "0.6.90b432",
    "description": "Run and manage local AI models, then search your files, code, and crawled web pages, with answers that cite the source. One program, no server to run.",
    "homepage": "https://lilbee.sh/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/tobocop2/lilbee/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/tobocop2/lilbee/releases/download/v0.6.90b432/lilbee-windows-x86_64.exe#/lilbee.exe",
            "hash": "15bf138b514b6a982000a3d72ab0853a41e719f4d7ccc0ba5bdd51b4860316f0"
        }
    },
    "bin": "lilbee.exe",
    "post_install": [
        "# Windows driver floors, from the CUDA toolkit release notes: 12.5 needs",
        "# 555.85, 12.4 needs 551.61. Below both, Vulkan is the only option.",
        "# --query-gpu is machine-readable; the header layout is not.",
        "$build = ''",
        "$driver = ''",
        "$smi = Get-Command nvidia-smi -ErrorAction SilentlyContinue",
        "if ($smi) {",
        "    $driver = \"$(& nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>$null | Select-Object -First 1)\".Trim()",
        "    $parsed = $null",
        "    # [version] compares field by field, so 551.86 sorts above 551.61 and the",
        "    # three-component form drivers report on Linux (550.54.14) still parses.",
        "    if ([version]::TryParse($driver, [ref]$parsed)) {",
        "        if ($parsed -ge [version]'555.85') { $build = 'cu125' }",
        "        elseif ($parsed -ge [version]'551.61') { $build = 'cu124' }",
        "    }",
        "}",
        "if ($build) {",
        "    $cudaHashes = @{",
        "        'cu125' = '92c8684f57581e2536891eb430a384d5df793a3a53170d1b9cc6fa99bad760d0'",
        "        'cu124' = '8912d393e74dc5b44c58426f3d4a3b8ddb7085f8a760064f9b5c85307b26d1fc'",
        "    }",
        "    $expected = $cudaHashes[$build]",
        "    $url = \"https://github.com/tobocop2/lilbee/releases/download/v$version/lilbee-windows-x86_64-$build.exe\"",
        "    $exe = Join-Path $dir 'lilbee.exe'",
        "    Write-Host \"lilbee: NVIDIA driver $driver detected, installing the $build build\"",
        "    Invoke-WebRequest -Uri $url -OutFile $exe",
        "    $actual = (Get-FileHash $exe -Algorithm SHA256).Hash.ToLower()",
        "    if ($actual -ne $expected) { throw \"lilbee: $build checksum mismatch (expected $expected, got $actual)\" }",
        "} elseif ($smi) {",
        "    Write-Host \"lilbee: NVIDIA driver '$driver' is older than 551.61, keeping the Vulkan build\"",
        "}"
    ]
}
